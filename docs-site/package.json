{
  "name": "molii-docs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "docusaurus start --host 127.0.0.1 --port 3100",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1 --port 3100",
    "preview": "docusaurus serve --host 127.0.0.1 --port 3100",
    "test": "bun test",
    "check:forbidden": "bun scripts/check-forbidden-terms.mjs",
    "check:secrets": "secretlint \"docs/**/*.{md,mdx}\"",
    "check:links": "sh scripts/check-links.sh",
    "check:links:external": "sh scripts/check-links.sh --external",
    "check": "bun test && bun run check:forbidden && bun run check:secrets && bun run build && bun run check:links",
    "api:prepare": "bun scripts/prepare-openapi.mjs",
    "api:lint": "bun run api:prepare && redocly lint generated/openapi/relay.public.json"
  },
  "dependencies": {
    "@cmfcmf/docusaurus-search-local": "2.0.1",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@fontsource-variable/lora": "5.2.8",
    "@node-rs/jieba": "2.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@redocly/cli": "2.46.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "linkinator": "8.0.3",
    "playwright-core": "1.62.1",
    "secretlint": "13.0.4",
    "typescript": "5.9.3"
  }
}
