{
  "name": "molii-docs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "docusaurus start --host 127.0.0.1 --port 3100",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1 --port 3100",
    "test": "bun test",
    "check:links": "linkinator build --recurse --skip 127.0.0.1",
    "api:prepare": "bun scripts/prepare-openapi.mjs",
    "api:lint": "bun run api:prepare && redocly lint generated/openapi/relay.public.json",
    "api:generate": "bun scripts/prepare-openapi.mjs --prepare-for-generation && docusaurus gen-api-docs relay"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@cmfcmf/docusaurus-search-local": "2.0.1",
    "docusaurus-plugin-openapi-docs": "5.1.3",
    "docusaurus-theme-openapi-docs": "5.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@redocly/cli": "2.46.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "linkinator": "8.0.3",
    "playwright-core": "1.62.1",
    "secretlint": "13.0.4",
    "typescript": "5.9.3"
  }
}
