# Build with DOCS_BASE_URL=/docs/ and copy build/ into <site-root>/docs/.
server {
    listen 8080;
    root /absolute/path/to/site-root;
    index index.html;

    location = /docs {
        return 308 /docs/quick-start;
    }

    location = /docs/ {
        return 308 /docs/quick-start;
    }

    location ^~ /docs/assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ^~ /docs/ {
        try_files $uri/index.html $uri =404;
    }
}
