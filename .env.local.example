# Copy this file to .env before running the API locally.
# Replace this placeholder with: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Local PostgreSQL and Redis containers from docker-compose.dev.yml.
SQL_DSN=postgresql://new_api:new_api_local@127.0.0.1:5432/new_api?sslmode=disable
REDIS_CONN_STRING=redis://127.0.0.1:6379/0

# Local HTTP only. Never use this setting for a production HTTPS deployment.
SESSION_COOKIE_SECURE=false
# 推荐由前端开发服务器代理 /api，此时不要配置 CORS 白名单。
# 如需 http://localhost:5173 直接请求本机 API，可取消下一行注释。
# DASHBOARD_CORS_ALLOWED_ORIGINS=http://localhost:5173

PORT=3000
GIN_MODE=debug
DEBUG=true
TZ=Asia/Shanghai
