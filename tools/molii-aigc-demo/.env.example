# Generate with: openssl rand -base64 32
MOLII_DEMO_MASTER_KEY=

# The Demo is intentionally loopback-only by default.
MOLII_DEMO_ADDR=127.0.0.1:8787
MOLII_DEMO_DB=./var/molii-aigc-demo.db

# Outbound request and polling limits.
MOLII_DEMO_REQUEST_TIMEOUT=60s
MOLII_DEMO_POLL_INTERVAL=4s
MOLII_DEMO_POLL_TIMEOUT=30m
MOLII_DEMO_BILLING_SYNC_INTERVAL=5s
MOLII_DEMO_SESSION_TTL=24h

# Set to true only when the Demo itself is served over HTTPS.
MOLII_DEMO_COOKIE_SECURE=false

# Optional comma-separated Host header allowlist when using a trusted reverse proxy.
MOLII_DEMO_ALLOWED_HOSTS=
