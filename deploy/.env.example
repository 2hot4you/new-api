# Published release image. A matching sha-* tag is also provided after release.
NEW_API_IMAGE=pangmaom1/new-api:molii-2026.08.03

# Bind only to loopback. Let the host reverse proxy expose HTTPS later.
NEW_API_BIND_ADDRESS=127.0.0.1
NEW_API_PORT=3000

# Generate URL-safe values, for example: openssl rand -hex 24
POSTGRES_DB=new_api
POSTGRES_USER=new_api
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
REDIS_PASSWORD=replace-with-a-random-redis-password

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Temporary trusted HTTP mode. Keep the port loopback-only in this mode.
# After HTTPS is configured, set this to true and configure the exact public
# origin in SESSION_COOKIE_TRUSTED_URL.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=
DASHBOARD_CORS_ALLOWED_ORIGINS=

GIN_MODE=release
DEBUG=false
TZ=Asia/Shanghai
NODE_TYPE=master
NODE_NAME=molii-new-api-1

# No reverse proxy headers are trusted until the real proxy address is known.
TRUSTED_PROXIES=none

ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
SYNC_FREQUENCY=60
