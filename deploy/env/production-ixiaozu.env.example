# Copy to /opt/ixiaozu/production/.env.runtime, fill the four empty secrets,
# and set file permissions to 0600. Do not commit the completed file.
# SQL_DSN=postgresql://new_api_ixiaozu:URL_ENCODED_PASSWORD@POSTGRES_HOST:5432/new_api_ixiaozu?sslmode=verify-full&sslrootcert=/app/certs/tencentdb-postgresql-ca.pem
SQL_DSN=
# REDIS_CONN_STRING=rediss://:URL_ENCODED_PASSWORD@REDIS_HOST:6379/0
REDIS_CONN_STRING=
REDIS_TLS_CA_FILE=/app/certs/tencentdb-redis-ca.pem
SESSION_SECRET=
CRYPTO_SECRET=

TZ=Asia/Shanghai
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=ixiaozu-production
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://aigc.ixiaozu.cn

# Managed catalog synchronization is opt-in. These examples never authorize
# an apply. Provision secrets separately in this site's protected runtime file.
CATALOG_SYNC_ROLE=disabled
CATALOG_SYNC_EXTERNAL_ORIGIN=https://aigc.ixiaozu.cn
# External origin is also required for browser read-only status when disabled
# or source; source export itself does not require a browser origin.
# Enable only after confirming a single master instance and this manual NODE_NAME:
# CATALOG_SYNC_SINGLE_INSTANCE=true
# CATALOG_SYNC_SOURCE_ID=dev
# Target setup: CATALOG_SYNC_ROLE=target; CATALOG_SYNC_TARGET_ID=ixiaozu
# CATALOG_SYNC_TOKEN=<unique-reader-id>.<base64url-32-random-bytes>
# Give each target a different token; install only its SHA-256 verifier on dev.
# Do not set CATALOG_SYNC_READERS_JSON on targets.
# Keep tokens/verifiers out of frontend variables, exported previews and logs.
# Validate dev first, then each confirmed target: connection, read-only preview,
# permissions and health only. No automatic apply or paid upstream request.
